---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar sesión · mi-timer">
  <div class="auth-shell">
    <div class="auth-card">
      <h1>Bienvenido a mi-timer</h1>
      <p class="subtitle">Ingresá para gestionar tus timers</p>

      <div class="alert alert-error" data-error-box style="display: none"></div>

      <form data-login-form novalidate>
        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="tu@email.com"
            required
          />
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <input
            id="password"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          />
        </div>

        <button class="btn btn-primary" type="submit" data-submit>Ingresar</button>
      </form>

      <p class="auth-switch">
        ¿No tenés cuenta?
        <a href="/mi-timer/register">Crear cuenta</a>
      </p>
    </div>
  </div>

  <script>
    import { onAuth, loginUsuario } from '../scripts/auth';

    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    const errorBox = document.querySelector<HTMLElement>('[data-error-box]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit]');

    function mostrarError(msg: string) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.style.display = '';
    }

    function limpiarError() {
      if (errorBox) errorBox.style.display = 'none';
    }

    onAuth((user) => {
      if (user) {
        window.location.href = '/mi-timer/timers';
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      limpiarError();

      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;

      if (!email || !password) {
        mostrarError('Completá email y contraseña para continuar.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Ingresando…';
      }

      try {
        await loginUsuario(email, password);
      } catch (err) {
        const friendly = (err as Error).message ?? 'Error al iniciar sesión.';
        mostrarError(friendly);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Ingresar';
        }
      }
    });
  </script>
</Layout>