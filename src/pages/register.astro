---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Crear cuenta · mi-timer">
  <div class="auth-shell">
    <div class="auth-card">
      <h1>Crear cuenta</h1>
      <p class="subtitle">Armá tu espacio para mis timers</p>

      <div class="alert alert-error" data-error-box style="display: none"></div>

      <form data-register-form novalidate>
        <div class="field">
          <label for="nombre">Nombre</label>
          <input
            id="nombre"
            type="text"
            name="nombre"
            autocomplete="name"
            placeholder="Tu nombre"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="tu@email.com"
            required
          />
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <input
            id="password"
            type="password"
            name="password"
            autocomplete="new-password"
            placeholder="Mínimo 6 caracteres"
            required
          />
          <span class="hint">Mínimo 6 caracteres.</span>
        </div>

        <div class="field">
          <label for="confirm">Confirmar contraseña</label>
          <input
            id="confirm"
            type="password"
            name="confirm"
            autocomplete="new-password"
            placeholder="Repetí la contraseña"
            required
          />
        </div>

        <button class="btn btn-primary" type="submit" data-submit>
          Crear cuenta
        </button>
      </form>

      <p class="auth-switch">
        ¿Ya tenés cuenta?
        <a href="/mi-timer/login">Iniciar sesión</a>
      </p>
    </div>
  </div>

  <script>
    import { onAuth, registrarUsuario } from '../scripts/auth';

    const form = document.querySelector<HTMLFormElement>('[data-register-form]');
    const errorBox = document.querySelector<HTMLElement>('[data-error-box]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit]');

    function mostrarError(msg: string) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.style.display = '';
    }

    function limpiarError() {
      if (errorBox) errorBox.style.display = 'none';
    }

    onAuth((user) => {
      if (user) window.location.href = '/mi-timer/timers';
    });

    function campo(nombre: string): HTMLInputElement {
      return form?.elements.namedItem(nombre) as HTMLInputElement;
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      limpiarError();

      const nombre = campo('nombre').value.trim();
      const email = campo('email').value.trim();
      const password = campo('password').value;
      const confirm = campo('confirm').value;

      if (!nombre || !email || !password) {
        mostrarError('Completá todos los campos.');
        return;
      }
      if (password.length < 6) {
        mostrarError('La contraseña debe tener al menos 6 caracteres.');
        return;
      }
      if (password !== confirm) {
        mostrarError('Las contraseñas no coinciden.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando cuenta…';
      }

      try {
        await registrarUsuario(nombre, email, password);
        window.location.href = '/mi-timer/timers';
      } catch (err) {
        const friendly = (err as Error).message ?? 'Error al crear la cuenta.';
        mostrarError(friendly);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Crear cuenta';
        }
      }
    });
  </script>
</Layout>