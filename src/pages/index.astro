---
import Layout from '../layouts/Layout.astro';
---

<Layout title="mi-timer · Cuentas regresivas">
  <section class="hero-mini">
    <div class="container hero-mini-inner">
      <div class="hero-mini-text">
        <div class="hero-badge">⏱ Cuenta regresiva, sin estrés</div>
        <h1 class="hero-title">
          mi-<span class="hero-accent">timer</span>
        </h1>
        <p class="hero-sub">
          Creá tus propios timers con fecha de inicio y fin, personalizá cada
          tarjeta con colores y tamaños, y seguí tu progreso en vivo.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="btn btn-primary"
          data-auth="logged-out-only"
          href="/mi-timer/login?tab=registro"
          style="display: none"
        >
          Crear cuenta
        </a>
        <a
          class="btn"
          data-auth="logged-out-only"
          href="/mi-timer/login"
          style="display: none"
        >
          Iniciar sesión
        </a>
        <a
          class="btn btn-primary"
          data-auth="logged-in-only"
          href="/mi-timer/config"
          style="display: none"
        >
          + Nuevo timer
        </a>
      </div>
    </div>
  </section>

  <div class="container timers-page">
    <!-- Cabecera: usuario con sesión -->
    <div class="timers-hero" data-hero-user style="display: none">
      <div>
        <h1>Mis timers</h1>
        <p class="sub" data-greeting>Gestioná tus cuentas regresivas</p>
      </div>
    </div>

    <!-- Cabecera: presentación sin sesión -->
    <div class="timers-hero" data-hero-demo style="display: none">
      <div>
        <h1>Timers de ejemplo</h1>
        <p class="sub">
          Así se ve mi-timer. Creá tu cuenta para tener los tuyos.
        </p>
      </div>
    </div>

    <div class="loading-row" data-loading>
      <div class="spinner"></div>
    </div>

    <div class="timers-grid" data-timers-grid></div>

    <div class="empty-state" data-empty style="display: none">
      <div class="empty-icon">⏰</div>
      <h2>Todavía no tenés timers</h2>
      <p>Creá tu primera cuenta regresiva para empezar a contar el tiempo.</p>
      <a class="btn btn-primary" href="/mi-timer/config">
        + Crear mi primer timer
      </a>
    </div>

    <div class="demo-note" data-demo-note style="display: none">
      <p>
        <span class="demo-note-icon">✨</span>
        Redimensioná las tarjetas arrastrando la esquina inferior derecha y bloqueá
        el tamaño con el candado. Los timers de ejemplo guardan los cambios en tu
        navegador hasta que crees tu cuenta.
      </p>
    </div>
  </div>

  <section class="container features">
    <div class="feature">
      <div class="feature-icon">🎨</div>
      <h3>Personalizable</h3>
      <p>Cada tarjeta con su propio color y tamaño.</p>
    </div>
    <div class="feature">
      <div class="feature-icon">📊</div>
      <h3>Progreso en vivo</h3>
      <p>Barra de avance y porcentaje actualizados cada segundo.</p>
    </div>
    <div class="feature">
      <div class="feature-icon">🔐</div>
      <h3>Tus datos</h3>
      <p>Guardá tus timers vinculados a tu cuenta.</p>
    </div>
  </section>

  <script>
    import { onAuth } from '../scripts/auth';
    import {
      leerTimers,
      actualizarCampoTimer,
      WIDTH_MIN,
      WIDTH_MAX,
    } from '../scripts/timers';
    import { timersDemo, guardarCustomDemo } from '../scripts/demo';
    import {
      timerCardHtml,
      initTimerCards,
      configurarTimerCards,
    } from '../scripts/timerCard';

    const timersGrid = document.querySelector<HTMLElement>('[data-timers-grid]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty]');
    const loading = document.querySelector<HTMLElement>('[data-loading]');
    const heroUser = document.querySelector<HTMLElement>('[data-hero-user]');
    const heroDemo = document.querySelector<HTMLElement>('[data-hero-demo]');
    const demoNote = document.querySelector<HTMLElement>('[data-demo-note]');
    const greeting = document.querySelector<HTMLElement>('[data-greeting]');

    function getHourMessage(): string {
      const h = new Date().getHours();
      if (h < 12) return 'Buenos días';
      if (h < 19) return 'Buenas tardes';
      return 'Buenas noches';
    }

    function mostrarGrid(hay: boolean) {
      emptyState!.style.display = hay ? 'none' : '';
      timersGrid!.style.display = hay ? 'flex' : 'none';
    }

    function renderTimersUsuario(userId: string) {
      const timers = leerTimers(userId);
      timersGrid!.innerHTML = timers.map(timerCardHtml).join('\n');
      configurarTimerCards(timersGrid!, {
        onResize: (id, width, height) =>
          actualizarCampoTimer(userId, id, {
            width: Math.min(WIDTH_MAX, Math.max(WIDTH_MIN, width)),
            height,
          }),
        onLock: (id, locked) => actualizarCampoTimer(userId, id, { locked }),
      });
      initTimerCards(timersGrid!);
      mostrarGrid(timers.length > 0);
    }

    function renderPresentacion() {
      const timers = timersDemo();
      timersGrid!.innerHTML = timers.map(timerCardHtml).join('\n');
      configurarTimerCards(timersGrid!, {
        onResize: (id, width, height) =>
          guardarCustomDemo(id, {
            width: Math.min(WIDTH_MAX, Math.max(WIDTH_MIN, width)),
            height,
          }),
        onLock: (id, locked) => guardarCustomDemo(id, { locked }),
      });
      initTimerCards(timersGrid!);
      mostrarGrid(true);
    }

    onAuth((user) => {
      loading!.style.display = 'none';

      if (user && typeof user.uid === 'string') {
        const name = user.displayName || user.email.split('@')[0] || '';
        const saludo = `${getHourMessage()}, ${name}!`;
        if (greeting) greeting.textContent = saludo;
        heroUser!.style.display = '';
        heroDemo!.style.display = 'none';
        demoNote!.style.display = 'none';
        renderTimersUsuario(user.uid);
      } else {
        heroUser!.style.display = 'none';
        heroDemo!.style.display = '';
        demoNote!.style.display = '';
        renderPresentacion();
      }
    });
  </script>

  <style>
    .hero-mini {
      border-bottom: 1px solid var(--border);
      background: radial-gradient(
        ellipse 70% 100% at 50% -20%,
        var(--accent-glow),
        transparent
      );
    }

    .hero-mini-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
      padding: 2.6rem 0 2.2rem;
    }

    .hero-badge {
      display: inline-block;
      padding: 0.35rem 1rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background-color: var(--bg-panel);
      color: var(--text-dim);
      font-size: 0.95rem;
      letter-spacing: 1px;
      margin-bottom: 0.9rem;
    }

    .hero-title {
      font-size: clamp(2.6rem, 6vw, 4.2rem);
      letter-spacing: 5px;
      margin: 0 0 0.5rem;
      text-shadow: 0 0 30px var(--accent-glow);
    }

    .hero-accent {
      color: var(--accent);
    }

    .hero-sub {
      color: var(--text-dim);
      font-size: 1.15rem;
      line-height: 1.5;
      margin: 0;
      max-width: 540px;
    }

    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .hero-actions .btn {
      padding: 0.8rem 1.7rem;
      font-size: 1.1rem;
    }

    .timers-page {
      padding-top: 2rem;
    }

    .loading-row {
      display: flex;
      justify-content: center;
      min-height: 120px;
      align-items: center;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      padding-bottom: 3.5rem;
    }

    .feature {
      background-color: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      transition: border-color 0.2s ease;
    }

    .feature:hover {
      border-color: var(--accent);
    }

    .feature-icon {
      font-size: 1.7rem;
      margin-bottom: 0.6rem;
    }

    .feature h3 {
      margin: 0 0 0.35rem;
      font-size: 1.3rem;
      color: var(--text);
    }

    .feature p {
      margin: 0;
      color: var(--text-dim);
      font-size: 1.02rem;
      line-height: 1.4;
    }

    @media (max-width: 720px) {
      .hero-mini-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .features {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>