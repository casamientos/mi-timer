---
import Layout from '../layouts/Layout.astro';
---

<Layout title="mi-timer · Cuentas regresivas">
  <section class="landing">
    <div class="container landing-inner">
      <div class="hero">
        <div class="hero-badge">⏱ Cuenta regresiva, sin estrés</div>
        <h1 class="hero-title">
          mi-<span class="hero-accent">timer</span>
        </h1>
        <p class="hero-sub">
          Creá tus propios timers con fecha de inicio y fin, personalizá cada
          tarjeta con colores y tamaños, y seguí tu progreso en vivo.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/mi-timer/config">
            + Crear un timer
          </a>
          <a class="btn" href="/mi-timer/timers">Ver mis timers</a>
        </div>
      </div>

      <div class="features">
        <div class="feature">
          <div class="feature-icon">🎨</div>
          <h3>Personalizable</h3>
          <p>Cada tarjeta con su propio color y tamaño.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">📊</div>
          <h3>Progreso en vivo</h3>
          <p>Barra de avance y porcentaje actualizados cada segundo.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🔐</div>
          <h3>Tus datos</h3>
          <p>Guardá tus timers vinculados a tu cuenta.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { onAuth } from '../scripts/auth';

    onAuth((user) => {
      if (user) {
        window.location.href = '/mi-timer/timers';
        return;
      }
      const cta = document.querySelector('a[href="/mi-timer/config"]');
      if (cta) cta.textContent = '+ Crear un timer';
    });
  </script>

  <style>
    .landing {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 64px);
      padding: 3rem 0;
    }

    .landing-inner {
      text-align: center;
    }

    .hero {
      max-width: 720px;
      margin: 0 auto;
    }

    .hero-badge {
      display: inline-block;
      padding: 0.4rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background-color: var(--bg-panel);
      color: var(--text-dim);
      font-size: 1rem;
      letter-spacing: 1px;
      margin-bottom: 1.4rem;
    }

    .hero-title {
      font-size: clamp(3.4rem, 9vw, 6.5rem);
      letter-spacing: 6px;
      margin: 0 0 0.8rem;
      text-shadow: 0 0 40px var(--accent-glow);
    }

    .hero-accent {
      color: var(--accent);
    }

    .hero-sub {
      color: var(--text-dim);
      font-size: 1.35rem;
      line-height: 1.5;
      margin: 0 auto 2rem;
      max-width: 560px;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .hero-actions .btn {
      padding: 0.9rem 2.2rem;
      font-size: 1.2rem;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 4rem;
      text-align: left;
    }

    .feature {
      background-color: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.6rem;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .feature:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
    }

    .feature-icon {
      font-size: 1.8rem;
      margin-bottom: 0.7rem;
    }

    .feature h3 {
      margin: 0 0 0.4rem;
      font-size: 1.35rem;
      color: var(--text);
    }

    .feature p {
      margin: 0;
      color: var(--text-dim);
      font-size: 1.05rem;
      line-height: 1.4;
    }

    @media (max-width: 720px) {
      .features {
        grid-template-columns: 1fr;
      }

      .landing {
        min-height: auto;
        padding: 2.5rem 0;
      }
    }
  </style>
</Layout>