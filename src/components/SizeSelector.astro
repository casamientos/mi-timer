---
import { TAMAÑOS } from '../scripts/timers';

interface Props {
  width?: number;
  name: string;
}

const { width = 330, name } = Astro.props;
---

<div class="size-selector" data-size-selector>
  {TAMAÑOS.map((t) => (
    <button
      type="button"
      class="size-option option-{t.value}"
      data-preset-width={t.width}
    >
      <span class="size-name">{t.label}</span>
      <span class="size-preview preview-{t.value}"></span>
      <span class="size-hint">{t.hint}</span>
    </button>
  ))}
  <input type="hidden" name={name} data-width-input value={width} />
  <div class="width-row">
    <span>Ancho actual:</span>
    <b data-width-label>{width}px</b>
  </div>
</div>

<style>
  .size-selector {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .size-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 0.6rem;
    background-color: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .size-option:hover {
    border-color: var(--accent);
  }

  .size-option.selected {
    border-color: var(--accent);
    background-color: var(--accent-glow);
    box-shadow: 0 0 14px var(--accent-glow);
  }

  .size-name {
    color: var(--text);
    letter-spacing: 1px;
    font-size: 1.05rem;
  }

  .size-hint {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .size-preview {
    display: block;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background-color: var(--bg-card);
    position: relative;
    height: 22px;
    width: min(40%, 56px);
    transition: width 0.15s ease;
  }

  .size-preview::after {
    content: '';
    position: absolute;
    height: 3px;
    width: 70%;
    left: 15%;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 999px;
    background-color: var(--accent);
  }

  .preview-small {
    width: min(28%, 36px);
  }

  .preview-medium {
    width: min(38%, 48px);
  }

  .preview-large {
    width: min(48%, 62px);
  }

  .width-row {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .width-row b {
    color: var(--accent);
    letter-spacing: 1px;
  }

  @media (max-width: 480px) {
    .size-selector {
      grid-template-columns: 1fr;
    }

    .width-row {
      grid-column: 1;
    }
  }
</style>

<script>
  function initSelector(selector: HTMLElement) {
    const hidden = selector.querySelector<HTMLInputElement>('[data-width-input]');
    const label = selector.querySelector<HTMLElement>('[data-width-label]');
    const options = Array.from(
      selector.querySelectorAll<HTMLElement>('[data-preset-width]'),
    );

    function aplicarWidth(width: number) {
      const w = Math.max(220, Math.min(560, Math.round(width)));
      if (hidden) hidden.value = String(w);
      if (label) label.textContent = `${w}px`;
      options.forEach((opt) => {
        const preset = Number(opt.dataset.presetWidth ?? 0);
        opt.classList.toggle('selected', preset === w);
      });
      selector.dispatchEvent(
        new CustomEvent('widthchange', { detail: { width: w }, bubbles: true }),
      );
    }

    options.forEach((opt) => {
      opt.addEventListener('click', () =>
        aplicarWidth(Number(opt.dataset.presetWidth ?? 0)),
      );
    });

    selector.addEventListener('widthvalue', (event) => {
      const detail = (event as CustomEvent).detail;
      if (detail && typeof detail.width === 'number') aplicarWidth(detail.width);
    });

    if (hidden?.value) {
      const current = Number(hidden.value);
      if (!Number.isNaN(current)) aplicarWidth(current);
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-size-selector]')
    .forEach(initSelector);
</script>